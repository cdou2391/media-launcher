{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum window controls for the media launcher",
  "webviews": ["main"],
  "permissions": [
    "allow-open-target",
    "allow-launch-shortcut",
    "allow-open-internal",
    "allow-browser-status",
    "allow-browser-home",
    "allow-browser-reveal",
    "allow-browser-retry",
    "allow-browser-external",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-usage-foreground",
    "core:window:allow-close"
  ]
}
